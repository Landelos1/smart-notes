# Copy to .env.local for local development. Frontend VITE_* values are public.
VITE_VERSION=3.0.1
VITE_PORT=3006
VITE_BASE_URL=/
VITE_ACCESS_MODE=frontend
VITE_WITH_CREDENTIALS=false
VITE_OPEN_ROUTE_INFO=false
VITE_API_URL=/
VITE_API_PROXY_URL=http://127.0.0.1:8889
# Set a local random value if using the browser screen-lock feature.
VITE_LOCK_ENCRYPT_KEY=
